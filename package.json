{
  "name": "evaristo-cultural-cms",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:sitio": "npm run build --workspace=@evaristo/sitio",
    "dev": "npm run build && npm run dev --workspace=@evaristo/api",
    "dev:sitio": "npm run dev --workspace=@evaristo/sitio",
    "db:generate": "npm run db:generate --workspace=@evaristo/compartido",
    "db:migrate": "npm run db:migrate --workspace=@evaristo/compartido",
    "test:migracion": "npm run test:migracion --workspace=@evaristo/compartido",
    "test:conversor": "npm run test:conversor --workspace=@evaristo/compartido",
    "test:media": "npm run test:media --workspace=@evaristo/api",
    "test:media-originales": "npm run test:media-originales --workspace=@evaristo/api --",
    "test:articulos": "npm run test:articulos --workspace=@evaristo/api --",
    "test:autores": "npm run test:autores --workspace=@evaristo/api --",
    "test:redirecciones": "npm run test:redirecciones --workspace=@evaristo/api",
    "test:redirecciones-base": "npm run test:redirecciones-base --workspace=@evaristo/api",
    "test:humo": "npm run test:humo --workspace=@evaristo/api --",
    "test:fase3": "npm run build:sitio && npm run test:render && npm run test:media && npm run test:redirecciones && npm run test:articulos && npm run test:autores && npm run test:secciones && npm run test:categorias && npm run test:redirecciones-base && npm run test:humo",
    "test:secciones": "npm run test:secciones --workspace=@evaristo/api --",
    "test:categorias": "npm run test:categorias --workspace=@evaristo/api --",
    "usuario:crear": "npm run usuario:crear --workspace=@evaristo/api --",
    "test:auth": "npm run test:auth --workspace=@evaristo/api",
    "test:auth-base": "npm run test:auth-base --workspace=@evaristo/api",
    "test:admin-articulos": "npm run test:admin-articulos --workspace=@evaristo/api",
    "test:render": "npm run test:render --workspace=@evaristo/compartido",
    "test:render-35": "npm run test:render-35 --workspace=@evaristo/compartido",
    "render:preview-35": "npm run render:preview-35 --workspace=@evaristo/compartido --",
    "db:probar": "npm run db:probar --workspace=@evaristo/compartido",
    "db:deploy": "npm run db:deploy --workspace=@evaristo/compartido",
    "db:nueva": "npm run db:nueva --workspace=@evaristo/compartido --",
    "db:verificar": "npm run db:verificar --workspace=@evaristo/compartido",
    "build:panel": "npm run build --workspace=@evaristo/panel",
    "build": "npm run build:sitio && npm run build:panel",
    "dev:panel": "npm run dev --workspace=@evaristo/panel",
    "db:sembrar": "npm run db:sembrar --workspace=@evaristo/compartido",
    "db:probar-modelo": "npm run db:probar-modelo --workspace=@evaristo/compartido"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
