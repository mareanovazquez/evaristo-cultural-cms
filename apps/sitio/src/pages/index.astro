---
import "../styles/portada.css";
import Base from "../layouts/Base.astro";
import Banner from "../components/Banner.astro";
import BloqueSeccion from "../components/BloqueSeccion.astro";
import Carrusel from "../components/Carrusel.astro";
import Tarjeta from "../components/Tarjeta.astro";
import { esNovedad, fechaLarga, posicionFocal, rutaArticulo, urlMedia } from "../lib/articulos";
import { leerBanner } from "../lib/banner";
import { datosDePortada, diapositivaDeNota, type NotaDePortada } from "../lib/portada";

// Portada (fase 5): se arma sola con lo publicado. Orden: fecha, carrusel de las 3 notas más nuevas, dos secciones, banda con las 3
// siguientes y «Últimas publicaciones», el banner promocional (si el administrador lo cargó) y las demás secciones. Ver docs/especificaciones/especificacion-home.md.
const { carrusel, banda, bloques: bloquesDeSeccion, novedades } = await datosDePortada();
const banner = await leerBanner();

const fecha = new Intl.DateTimeFormat("es-AR", { dateStyle: "full", timeZone: "America/Argentina/Buenos_Aires" }).format(new Date());
const hoy = fecha.charAt(0).toUpperCase() + fecha.slice(1);

const meta = (n: NotaDePortada) => `${n.autores.length ? `Por ${n.autores.map((x) => x.autor.nombre).join(", ")} · ` : ""}${fechaLarga(n.publicadoEn!)}`;
const imagenDe = (n: NotaDePortada) => (n.imagenEncabezado ? { src: urlMedia(n.imagenEncabezado.clave), posicion: posicionFocal(n.encabezadoPuntoFocalX, n.encabezadoPuntoFocalY) } : undefined);
// «Novedades» es el primer bloque (si hay notas marcadas como novedad); no es una sección, tiene su propia página
const bloques = [...(novedades.length ? [{ seccion: { slug: "novedades", nombre: "Novedades" }, notas: novedades, href: "/novedades/" }] : []), ...bloquesDeSeccion];
const arriba = bloques.slice(0, 2);
const abajo = bloques.slice(2);
const hayNotas = carrusel.length > 0;
// La bajada del h1 es también la meta description
const BAJADA = "Revista cultural de Evaristo Editorial: entrevistas, reseñas, ensayos y crónicas desde 2006.";
---

<Base titulo="Evaristo Cultural" descripcion={BAJADA}>
  {
    hayNotas ? (
      <div class="portada">
        <header class="portada-titulo">
          <h1 class="logo"><b>Evaristo</b> <span>Cultural</span></h1>
          <p class="portada-bajada">Revista cultural de Evaristo Editorial</p>
          <p class="portada-fecha">{hoy}</p>
        </header>

        <Carrusel diapositivas={carrusel.map(diapositivaDeNota)} intervalo={6000} />

        {arriba.length > 0 && (
          <div class="portada-bloques">
            {arriba.map((b) => (
              <BloqueSeccion seccion={b.seccion} notas={b.notas} href={"href" in b ? b.href : undefined} />
            ))}
          </div>
        )}

        {banda.length > 0 && (
          <section class="portada-banda" aria-labelledby="ultimas-publicaciones">
            <div class="banda-presentacion">
              <h2 id="ultimas-publicaciones">Últimas publicaciones</h2>
              <p>Lo más nuevo de la revista.</p>
              <a class="ver-todo" href="/ultimas/">
                Ver todo
                <svg class="icon" aria-hidden="true"><use href="#i-arrow-right" /></svg>
              </a>
            </div>
            {banda.map((n) => (
              <Tarjeta href={rutaArticulo({ slug: n.slug, publicadoEn: n.publicadoEn! })} titulo={n.titulo} seccion={n.seccion.interna ? undefined : n.seccion.nombre} novedad={esNovedad(n.novedadHasta)} imagen={imagenDe(n)} meta={meta(n)} />
            ))}
          </section>
        )}

        <Banner slides={banner} />

        {abajo.length > 0 && (
          <div class="portada-bloques">
            {abajo.map((b) => (
              <BloqueSeccion seccion={b.seccion} notas={b.notas} href={"href" in b ? b.href : undefined} />
            ))}
          </div>
        )}
      </div>
    ) : (
      <section class="section">
        <p class="vacio">Todavía no hay artículos publicados.</p>
      </section>
    )
  }
</Base>
