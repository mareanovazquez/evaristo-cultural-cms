---
import Base from "../layouts/Base.astro";
import Tarjeta from "../components/Tarjeta.astro";
import { fechaLarga, posicionFocal, rutaArticulo, ultimosArticulos, urlMedia } from "../lib/articulos";

// Portada provisoria: los últimos artículos. La portada real (destacados, secciones) es la fase 5.
const articulos = await ultimosArticulos(12);
---

<Base titulo="Evaristo Cultural" descripcion="Revista cultural de Evaristo Editorial.">
  <section class="section">
    <h1 class="titulo-pagina">Últimos artículos</h1>
    {
      articulos.length > 0 ? (
        <div class="grilla">
          {articulos.map((a) => (
            <Tarjeta
              href={rutaArticulo({ slug: a.slug, publicadoEn: a.publicadoEn! })}
              titulo={a.titulo}
              seccion={a.seccion.interna ? undefined : a.seccion.nombre}
              imagen={a.imagenEncabezado ? { src: urlMedia(a.imagenEncabezado.clave), posicion: posicionFocal(a.encabezadoPuntoFocalX, a.encabezadoPuntoFocalY) } : undefined}
              meta={`${a.autores.length ? `Por ${a.autores.map((x) => x.autor.nombre).join(", ")} · ` : ""}${fechaLarga(a.publicadoEn!)}`}
            />
          ))}
        </div>
      ) : (
        <p class="vacio">Todavía no hay artículos publicados.</p>
      )
    }
  </section>
</Base>
