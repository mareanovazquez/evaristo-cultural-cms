import Base from "../layouts/Base.astro";

// «Quiénes somos» (11/11/2026). TEXTO PROVISORIO: es la presentación de Evaristo Editorial, puesta para no dejar la página vacía mientras
// la editorial manda el texto de la revista (ver especificacion-home.md, sección 6). Cuando llegue, se reemplaza acá.
---

<Base titulo="Quiénes somos" descripcion="Evaristo Cultural, la revista de Evaristo Editorial.">
  <section class="section col">
    <h1 class="titulo-pagina">Quiénes somos</h1>
    <p>
      EVARISTO es una editorial independiente con búsquedas estéticas que se expanden hacia distintos horizontes: apuesta a las nuevas voces de la
      literatura contemporánea nacional, a la relectura y el rescate histórico, al pulp latinoamericano, a la narrativa de género y sus
      hibridaciones; a la novela gráfica, la crónica social, y también a la poesía.
    </p>
    <p>Nace en 2015 como evolución natural de un proyecto de más de diez años de gestión cultural.</p>
  </section>
</Base>
