---
import Base from "../../layouts/Base.astro";
import Articulo from "../../components/Articulo.astro";
import { renderArticleBody, type JSONNode } from "@evaristo/compartido/render";
import { prisma } from "../../lib/prisma";
import { pruebaLayoutHabilitada } from "../../lib/prueba-layout";

// Muestra un artículo PUBLICADO de la base con el renderizador y el layout. Página temporal (paso 2): la vista real es el paso 4.
// Con ?capital=1 se activa la letra capital.
if (!pruebaLayoutHabilitada()) return new Response("No encontrado", { status: 404 });

const wpId = Number(Astro.params.wpId);
if (!Number.isInteger(wpId)) return new Response("No encontrado", { status: 404 });

// select explícito: no se trae visitasWp ni nada que la página no use
const articulo = await prisma.articulo.findFirst({
  where: { wpId, estado: "PUBLICADO" },
  select: { titulo: true, bajada: true, cuerpo: true, publicadoEn: true, seccion: { select: { nombre: true } } },
});
if (!articulo) return new Response("No encontrado", { status: 404 });

const cuerpo = articulo.cuerpo as JSONNode;
const ids = new Set<number>();
const reunir = (n: JSONNode) => {
  const id = n.attrs?.["imagenId"];
  if (n.type === "imagen" && typeof id === "number") ids.add(id);
  n.content?.forEach(reunir);
};
reunir(cuerpo);
const medidas = await prisma.imagen.findMany({ where: { id: { in: [...ids] } }, select: { id: true, ancho: true, alto: true } });
const dimensionesImagenes = new Map(medidas.map((m) => [m.id, { ancho: m.ancho, alto: m.alto }]));

const { html, notesHtml } = renderArticleBody(cuerpo, { conCapital: Astro.url.searchParams.get("capital") === "1", dimensionesImagenes });
const fecha = articulo.publicadoEn
  ? new Intl.DateTimeFormat("es-AR", { dateStyle: "long", timeZone: "America/Argentina/Buenos_Aires" }).format(articulo.publicadoEn)
  : undefined;
---

<Base titulo={articulo.titulo} noindex>
  <Articulo seccion={articulo.seccion.nombre} titulo={articulo.titulo} bajada={articulo.bajada} meta={fecha} html={html} notesHtml={notesHtml} />
</Base>
