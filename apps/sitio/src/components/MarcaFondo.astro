---
// Palabra enorme fija en el fondo de la pantalla (7/11/2026; estilos en sitio.css, «Marca de fondo»). Es decoración: aria-hidden.
//   Portada: <MarcaFondo principal="Evaristo" secundaria="Cultural" />   (los dos pesos del wordmark)
//   Sección, Novedades y Contacto: <MarcaFondo principal={seccion.nombre} />   (una sola palabra, en el verde de la etiqueta)
//   Nota: <MarcaFondo principal={seccion.nombre} vertical />            (en el margen izquierdo, solo en pantallas anchas)
//   Contacto: <MarcaFondo principal="Contacto" alPie />                (no fija: al final de la página, apoyada sobre el footer)
interface Props {
  principal: string;
  secundaria?: string;
  vertical?: boolean;
  alPie?: boolean;
}
const { principal, secundaria, vertical = false, alPie = false } = Astro.props;
---

<p class:list={["marca-fondo", { "marca-fondo--sola": !secundaria, "marca-fondo--vertical": vertical, "marca-fondo--al-pie": alPie }]} aria-hidden="true">
  <b>{principal}</b>{secundaria && <> <span>{secundaria}</span></>}
</p>
