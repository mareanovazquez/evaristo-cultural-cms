---
import Marca from "./Marca.astro";

import { SECCIONES_VISIBLES, URL_AUTORES, urlSeccion } from "../lib/rutas";
import { listarSeccionesMenu } from "../lib/secciones";
import { leerTopbar } from "../lib/sitio";

// Topbar: lo edita el administrador en el panel («Sitio»). Apagado o sin texto, no se dibuja.
const topbar = await leerTopbar();

// Las secciones y su orden salen de la base: las administra el administrador desde el panel.
const SECCIONES_MENU = await listarSeccionesMenu();
const visibles = SECCIONES_MENU.slice(0, SECCIONES_VISIBLES);
const resto = SECCIONES_MENU.slice(SECCIONES_VISIBLES);
const ruta = Astro.url.pathname;
const actual = (href: string) => (ruta === href || ruta.startsWith(href) ? "page" : undefined);
---

{
  topbar &&
    (topbar.enlace ? (
      <a class="topbar" href={topbar.enlace}>
        <span>{topbar.texto}</span>
      </a>
    ) : (
      <p class="topbar topbar-sin-enlace">
        <span>{topbar.texto}</span>
      </p>
    ))
}
<header class="header">
  <div class="page header-fila">
    <Marca nombre="Cultural" />

    <nav class="menu-principal" aria-label="Secciones">
      <ul class="menu">
        {
          visibles.map((s) => (
            <li>
              <a href={urlSeccion(s.slug)} aria-current={actual(urlSeccion(s.slug))}>{s.nombre}</a>
            </li>
          ))
        }
        <li>
          <details class="mas">
            <summary>
              Más <svg class="icon icon-chev" aria-hidden="true"><use href="#i-chevron-down" /></svg>
            </summary>
            <div class="mas-panel">
              <a href="/novedades/" aria-current={actual("/novedades/")}>Novedades</a>
              {resto.map((s) => <a href={urlSeccion(s.slug)} aria-current={actual(urlSeccion(s.slug))}>{s.nombre}</a>)}
              <a href={URL_AUTORES} aria-current={actual(URL_AUTORES)}>Autores</a>
            </div>
          </details>
        </li>
      </ul>
    </nav>

    <a class="buscar" href="/buscar/" aria-label="Buscar en la revista" aria-current={actual("/buscar/")}>
      <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
    </a>

    <details class="menu-movil">
      <summary aria-label="Menú">
        <svg class="icon icon-menu" aria-hidden="true"><use href="#i-menu" /></svg>
        <svg class="icon icon-x" aria-hidden="true"><use href="#i-x" /></svg>
      </summary>
      <nav class="panel-movil" aria-label="Secciones">
        <ul>
          <li><a href="/novedades/" aria-current={actual("/novedades/")}>Novedades</a></li>
          {SECCIONES_MENU.map((s) => <li><a href={urlSeccion(s.slug)} aria-current={actual(urlSeccion(s.slug))}>{s.nombre}</a></li>)}
        </ul>
        <div class="secundario"><a href={URL_AUTORES}>Autores</a><a href="/buscar/">Buscar</a></div>
      </nav>
    </details>
  </div>
</header>

<script>
  // "Más" se cierra con un clic afuera o con Esc.
  const mas = document.querySelector<HTMLDetailsElement>("details.mas");
  if (mas) {
    document.addEventListener("click", (e) => {
      if (mas.open && !mas.contains(e.target as Node)) mas.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && mas.open) {
        mas.open = false;
        mas.querySelector("summary")?.focus();
      }
    });
  }
</script>
