---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/articulo.css";
import "../styles/sitio.css";
import Iconos from "../components/Iconos.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  titulo: string;
  descripcion?: string;
  noindex?: boolean;
}
const { titulo, descripcion, noindex = false } = Astro.props;
const tituloCompleto = titulo === "Evaristo Cultural" ? titulo : `${titulo} · Evaristo Cultural`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    {descripcion && <meta name="description" content={descripcion} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400&family=Inter:ital,wght@0,400;0,500;0,600;1,400&family=Roboto:wght@600;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="salto-contenido" href="#contenido">Saltar al contenido</a>
    <Iconos />
    <Header />
    <main id="contenido" class="page">
      <slot />
    </main>
    <Footer />
  </body>
</html>
