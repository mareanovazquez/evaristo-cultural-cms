NODE_ENV=development
# Cuántos proxies hay entre el servidor y quien visita (por ejemplo 1 detrás de un balanceador). Vacío: ninguno (lo seguro sin proxy). No usar "true".
TRUST_PROXY=
PORT=3000
DATABASE_URL="mysql://evaristo:CAMBIAR_CLAVE@127.0.0.1:3308/evaristo_cms"
SHADOW_DATABASE_URL="mysql://evaristo:CAMBIAR_CLAVE@127.0.0.1:3308/evaristo_cms_shadow"
# Base de desarrollo del panel y la API (copia de evaristo_cms). Se usa con --base-dev.
DATABASE_URL_DEV="mysql://evaristo:CAMBIAR_CLAVE@127.0.0.1:3308/evaristo_cms_dev"

# Carpeta con los originales de las imagenes (ruta absoluta). Sin ella, /media responde 503.
# En la maquina de desarrollo: la carpeta uploads-muestra/originales de CMS-EVARISTO(ASSETS).
MEDIA_DIR=

# Carpeta donde se guardan las imagenes que se suben desde el panel (ruta absoluta). Sin ella, subir responde 503.
# /media busca primero aca y despues en MEDIA_DIR. En la maquina de desarrollo: una carpeta propia (por ejemplo uploads-dev dentro
# de CMS-EVARISTO(ASSETS)) para no mezclar las pruebas con la muestra. La API la crea en la primera subida. En produccion puede ser
# la misma que MEDIA_DIR.
MEDIA_DIR_SUBIDAS=

# Cache en disco de las variantes de tamano (/media/<clave>?w=N, decision 83; ruta absoluta, la API la crea en la primera variante).
# Una carpeta propia, fuera de MEDIA_DIR y MEDIA_DIR_SUBIDAS: se puede borrar entera cuando se quiera, se vuelve a generar.
# Sin ella, ?w se ignora y se sirve el original. En la maquina de desarrollo: por ejemplo variantes-dev dentro de CMS-EVARISTO(ASSETS).
MEDIA_DIR_VARIANTES=

# Direccion publica del sitio, sin barra final (por ejemplo https://evaristocultural.com.ar). La usa el feed RSS (/feed/) para las
# direcciones completas; sin ella, toma el origen del pedido.
SITIO_URL=

# Formulario de contacto (/contacto/): correo saliente del hosting. Sin SMTP_HOST, en desarrollo el mensaje se anota en la consola
# del servidor y en produccion /api/contacto responde 503. Con SMTP_HOST hacen falta CONTACTO_DESTINO y CORREO_REMITENTE.
# SMTP_PUERTO: 465 por defecto. SMTP_SEGURO: true con el 465, false con el 587 (igual se exige STARTTLS).
SMTP_HOST=
SMTP_PUERTO=
SMTP_SEGURO=
SMTP_USUARIO=
SMTP_CLAVE=
# A quien le llegan los mensajes (el correo de la editorial).
CONTACTO_DESTINO=
# Quien manda los correos del sitio: una direccion del dominio, por ejemplo "Evaristo Cultural <web@evaristocultural.com.ar>".
CORREO_REMITENTE=
