NODE_ENV=development
# Cuántos proxies hay entre el servidor y quien visita (por ejemplo 1 detrás de un balanceador). Vacío: ninguno (lo seguro sin proxy). No usar "true".
TRUST_PROXY=
PORT=3000
DATABASE_URL="mysql://evaristo:CAMBIAR_CLAVE@127.0.0.1:3308/evaristo_cms"
SHADOW_DATABASE_URL="mysql://evaristo:CAMBIAR_CLAVE@127.0.0.1:3308/evaristo_cms_shadow"
# Base de desarrollo del panel y la API (copia de evaristo_cms). Se usa con --base-dev.
DATABASE_URL_DEV="mysql://evaristo:CAMBIAR_CLAVE@127.0.0.1:3308/evaristo_cms_dev"

# Carpeta con los originales de las imagenes (ruta absoluta). Sin ella, /media responde 503.
# En la maquina de desarrollo: la carpeta uploads-muestra/originales de CMS-EVARISTO(ASSETS).
MEDIA_DIR=

# Carpeta donde se guardan las imagenes que se suben desde el panel (ruta absoluta). Sin ella, subir responde 503.
# /media busca primero aca y despues en MEDIA_DIR. En la maquina de desarrollo: una carpeta propia (por ejemplo uploads-dev dentro
# de CMS-EVARISTO(ASSETS)) para no mezclar las pruebas con la muestra. La API la crea en la primera subida. En produccion puede ser
# la misma que MEDIA_DIR.
MEDIA_DIR_SUBIDAS=
